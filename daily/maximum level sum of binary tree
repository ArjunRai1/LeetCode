// Given the root of a binary tree, the level of its root is 1, the level of its children is 2, and so on.

// Return the smallest level x such that the sum of all the values of nodes at level x is maximal.


// Logic:
// We start level order traversal to calculate the sum of all nodes at a particular level. If the sum exceeds the currsum, we update currsum and 
// set the current level as the answer.



#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    int maxLevelSum(TreeNode* root) {
        if(!root || (!root->left && !root->right))
            return 1;
        int level = 0;
        int currsum = INT_MIN;
        int res;
        queue<TreeNode*>q;
        q.push(root);
        while(!q.empty())
        {
            int n = q.size();
            int sum = 0;
            for(int i = 0; i<n; i++)
            {
                TreeNode* temp = q.front();
                q.pop();
                sum += temp->val; 
                if(temp->left)
                    q.push(temp->left);
                if(temp->right)
                    q.push(temp->right);  
            }
            level++;
            if(sum>currsum)
            {
                currsum = sum;
                res = level;
            }
        }
        return res;
    }
};